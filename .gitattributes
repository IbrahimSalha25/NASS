# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.traineddata binary
